{
  "_说明": "把本文件复制为 config\\user.json 后按需修改；这里写到的每一项都会覆盖 config\\default.json 中的同路径配置（深度合并，未写的保持默认）。以 _ 开头的键仅作注释，空字符串表示“不覆盖”。",

  "installRoot": "D:\\JavaDevEnv",
  "existingPolicy": "prefer",
  "preferMirrors": "auto",

  "download": {
    "_说明": "githubAccelerators 是 github.com 直链的加速镜像（dbeaver/windterm/tinyrdm/redis 等组件的真实下载都在 GitHub）。预检可用者优先，全部失败自动回退直链；不想走第三方镜像就置 []。",
    "proxy": "",
    "retries": 3,
    "githubAccelerators": [
      "https://gh-proxy.com",
      "https://ghproxy.net",
      "https://ghfast.top"
    ]
  },

  "shortcuts": {
    "desktop": true,
    "startMenu": false,
    "items": ["ide", "dbeaver", "heidisql", "pg", "redis", "devshell", "root", "dsh", "dsh-cli", "dbinfo", "windterm", "apifox", "tinyrdm"]
  },

  "components": {
    "jdk": {
      "enabled": true,
      "versions": [21],
      "default": 21
    },

    "maven": {
      "enabled": true,
      "version": "3.9.9",
      "settings": {
        "mirror": "aliyun",
        "localRepository": "user",
        "overwriteExisting": false
      }
    },

    "ide": {
      "_说明": "version 支持：latest=全部版本取最新；2026.2=版本线写法（自动取该线最新补丁，默认）；2026.2.3=精确版本。最低支持 2025.3（统一分发版起点），写更低版本会直接报错",
      "enabled": true,
      "edition": "IC",
      "version": "2026.2",
      "portable": true,
      "vmOptionsHeap": ""
    },

    "git": { "enabled": true, "version": "2.46.0" },
    "node": { "enabled": true, "version": "20.18.0" },

    "_dsh说明": "dsh 默认装官方桌面端（Electron 客户端）；命令行版是另一个组件 dsh-cli，需要终端里的 dsh web / dsh tui 再打开它。autostart=true 时登录后自动启动桌面端",
    "dsh": {
      "enabled": true,
      "version": "latest",
      "autostart": false
    },

    "dsh-cli": {
      "enabled": false,
      "version": "latest",
      "registry": "https://registry.npmmirror.com"
    },

    "postgres": {
      "enabled": true,
      "version": "17.2",
      "port": 5432,
      "password": "postgres",
      "databases": ["devdb"],
      "createInstance": "auto",
      "startAfterInstall": true,
      "autostart": true
    },

    "redis": {
      "enabled": true,
      "port": 6379,
      "password": "",
      "maxmemory": "512mb",
      "createInstance": "auto",
      "startAfterInstall": true,
      "autostart": true
    },

    "dbeaver": { "enabled": true, "portable": true },
    "_数据库管理工具二选一": "dbeaver 与 heidisql 定位相同，默认只装 dbeaver；想换成轻量的 HeidiSQL 就按下面这样改",
    "heidisql": { "enabled": false, "portable": true },

    "windterm": {
      "_说明": "SSH/SFTP 远程管理终端（开源，便携 zip）。默认 version=latest 从 GitHub Release 解析；内网无法访问 GitHub 时写死版本号并确认缓存里已有安装包",
      "enabled": true,
      "version": "latest"
    },

    "apifox": {
      "_说明": "API 设计/调试/测试一体化工具。官方 zip 里是静默安装器，脚本解壳后用 /S /currentuser /D= 装进安装目录；缓存命中旧包时可删掉 cache\\Apifox-windows-latest.zip 或用 -Force 重下",
      "enabled": true
    },

    "tinyrdm": {
      "_说明": "轻量 Redis 可视化管理工具（便携 zip 约 12MB）。默认 version=latest 从 GitHub Release 解析",
      "enabled": true,
      "version": "latest"
    },

    "_extras_示例": "自定义软件：url 指向 zip，dirName 是解压目录名，exe 用于校验安装是否成功",
    "extras": [
      {
        "key": "vscode",
        "name": "VS Code",
        "enabled": false,
        "url": "https://update.code.visualstudio.com/latest/win32-x64-archive/stable",
        "fileName": "VSCode-win32-x64.zip",
        "dirName": "VSCode",
        "exe": "Code.exe",
        "pathEntries": ["bin"],
        "addToPath": true,
        "shortcuts": [{ "name": "VS Code", "target": "Code.exe" }]
      }
    ]
  }
}
